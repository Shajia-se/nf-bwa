params {
  bwa_raw_data   = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/pipelines/nf-fastp/fastp_output"         
  bwa_pattern    = "*_R{1,2}.fastp.trimmed.fastq.gz"
  samples_master = null
  project_folder = "$PWD"               
  bwa_output     = "bwa_output"         

  reference_root  = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/reference"
  genome_release  = "GRCm39"
  gencode_version = "vM27"
  reference_fasta = "${reference_root}/bwa/${genome_release}_${gencode_version}/${genome_release}.primary_assembly.genome.fa"
  index_dir       = "${reference_root}/bwa/${genome_release}_${gencode_version}/primary_bwa"

  container_bwa_sam   = "/ictstr01/groups/idc/projects/uhlenhaut/jiang/singularity_image/bwa-sam.sif"

  queue  = 'cpu_p'
  cpus   = 8
  memory = '16GB'
  time   = '6h'
  extra_mounts = ''
}

profiles {
  local { includeConfig 'configs/local.config' }
  hpc   { includeConfig 'configs/slurm.config' }
}
